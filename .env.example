# ===== 运行模式与数据目录（数据存储抽象）=====
# private：本地个人环境，数据落在 DATA_DIR（FileDataStore）
# demo   ：演示环境，数据落 Postgres（PostgresDataStore，需 DATABASE_URL）
APP_MODE=private
# 数据根目录；相对路径按项目根解析。demo 模式下不得包含 "private"（启动守卫）
DATA_DIR=./data/private

# ===== 模型密钥（config.yaml 中以 ${VAR} 引用）=====
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
# OPENAI_API_KEY=
# GEMINI_3_8_FLASH_API_KEY=

# ===== 安全层 =====
# 密钥库：留空用本地 SQLite（KEYS_DB）；填 Neon/PG 连接串则用 Postgres
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
KEYS_DB=data/keys.db
# 限流与预算计数（本地 Redis 或 Upstash 的 rediss://）
REDIS_URL=redis://127.0.0.1:6379/0
# /admin/* 管理端点令牌；未配置时管理端点返回 503
ADMIN_TOKEN=
# 创建密钥的硬性上限（保护上游额度，超限拒绝创建 400；所有角色不豁免）
# KEY_MAX_RPM=3
# KEY_MAX_DAILY_BUDGET_CNY=1.0

# ===== 成本换算 =====
# 上游模型实际计价单位（USD）与预算单位（人民币 CNY）的换算汇率
# config.yaml 中 price_input_usd / price_output_usd 为 USD/百万 tokens，
# 网关内部按此汇率换算为 CNY 再累加到预算
# USD_TO_CNY=7.2
